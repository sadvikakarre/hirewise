# App
APP_NAME=HireWise
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hirewise

# Redis
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# File Storage (use local path for dev, S3 for prod)
STORAGE_TYPE=local
LOCAL_UPLOAD_DIR=./uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=hirewise-resumes

# CORS
FRONTEND_URL=http://localhost:5173
